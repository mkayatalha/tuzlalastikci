---
import { business } from '../data/site';
interface Props { variant?: 'hero' | 'plain' }
const { variant = 'plain' } = Astro.props;
const wa = business.whatsapp ? `https://wa.me/${business.whatsapp}` : '';
---
<div class={`cta-row ${variant === "hero" ? "on-dark" : "plain"}`}>
  <a class="btn btn-call" href={`tel:${business.phoneE164}`} data-track="call">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8z"/></svg>
    Hemen ara <span class="num">{business.phone}</span>
  </a>
  {wa && <a class="btn btn-wa" href={wa} data-track="whatsapp" rel="noopener">WhatsApp</a>}
  <a class="btn btn-ghost" href={business.mapsUrl} data-track="directions" rel="noopener">Yol tarifi</a>
</div>
